Функция ВыполнитьPOST(Знач АдресСервиса, Знач Путь, Знач Данные) Экспорт
    
    ПараметрыАдреса = РазобратьАдрес(АдресСервиса);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);       
    СтрокаJSON = ЗаписьJSON.Закрыть();

	Соединение = Новый HTTPСоединение(ПараметрыАдреса.Хост, ПараметрыАдреса.Порт, , , , 30);
    Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");  
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	
	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "HTTP error " + Ответ.КодСостояния + ". Текст ответа: " + СтрокаОтвета;
	КонецЕсли;	

	Если ПустаяСтрока(СтрокаОтвета) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
    Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

Функция ВыполнитьGET(Знач АдресСервиса, Знач Путь) Экспорт
    
    ПараметрыАдреса = РазобратьАдрес(АдресСервиса);
    
	Соединение = Новый HTTPСоединение(ПараметрыАдреса.Хост, ПараметрыАдреса.Порт, , , , 30);

    Запрос = Новый HTTPЗапрос(Путь);    
	Запрос.Заголовки.Вставить("Accept", "application/json");
    
    Ответ = Соединение.Получить(Запрос);
    
	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "HTTP error " + Ответ.КодСостояния + ". Текст ответа: " + СтрокаОтвета;
	КонецЕсли;

	Если ПустаяСтрока(СтрокаОтвета) Тогда
		Возврат Новый Структура;
	КонецЕсли;  
	
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
    Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

Функция РазобратьАдрес(Знач Адрес) Экспорт
	
	// Готовим структуру с дефолтным портом 80 и пустым путем
	Результат = Новый Структура("Хост, Порт, ПутьAPI", "", 80, "");
	
	// Очищаем адрес от протоколов
	ЧистыйАдрес = СтрЗаменить(Адрес, "http://", "");
	ЧистыйАдрес = СтрЗаменить(ЧистыйАдрес, "https://", "");
	
	// Шаг 1. Отделяем путь API. Ищем первый слеш после имени сервера
	ПозицияСлеша = Найти(ЧистыйАдрес, "/");
	Если ПозицияСлеша > 0 Тогда
		// Все, что до слеша — это сервер и порт
		СтрокаХостПорт = Лев(ЧистыйАдрес, ПозицияСлеша - 1);
		// Все, что начиная со слеша — это путь API
		Результат.ПутьAPI = Сред(ЧистыйАдрес, ПозицияСлеша);
	Иначе
		// Если слеша нет, значит пути в адресе не было
		СтрокаХостПорт = ЧистыйАдрес;
		Результат.ПутьAPI = "";
	КонецЕсли;
	
	// Шаг 2. Разделяем оставшуюся строку на Хост и Порт
	Части = СтрРазделить(СтрокаХостПорт, ":");
	Результат.Хост = Части[0];
	
	Если Части.Количество() > 1 Тогда
		Попытка
			Результат.Порт = Число(Части[1]);
		Исключение
			// На случай, если в порту передали не число
			Результат.Порт = 80; 
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьЗначениеВТекст(Значение, Отступ)  Экспорт
	
	РезультатТекст = "";
	
	// Проверяем тип текущего узла данных
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		
		Для Каждого Элемент Из Значение Цикл
			РезультатТекст = РезультатТекст + Отступ + "[" + Элемент.Ключ + "]: ";
			
			// Если внутри структура или массив — идем на следующий уровень рекурсии
			Если ТипЗнч(Элемент.Значение) = Тип("Структура") Или ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
				РезультатТекст = РезультатТекст + Символы.ПС + ПреобразоватьЗначениеВТекст(Элемент.Значение, Отступ + "    ");
			Иначе
				// Обычное значение
				ЗначениеСтр = ?(ЗначениеЗаполнено(Элемент.Значение), Строка(Элемент.Значение), "<Пусто>");
				РезультатТекст = РезультатТекст + ЗначениеСтр + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из Значение Цикл
			РезультатТекст = РезультатТекст + Отступ + "  - ";
			
			Если ТипЗнч(ЭлементМассива) = Тип("Структура") Или ТипЗнч(ЭлементМассива) = Тип("Массив") Тогда
				РезультатТекст = РезультатТекст + Символы.ПС + ПреобразоватьЗначениеВТекст(ЭлементМассива, Отступ + "      ");
			Иначе
				РезультатТекст = РезультатТекст + Строка(ЭлементМассива) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		// Если это просто строка или число на входе
		РезультатТекст = Отступ + Строка(Значение) + Символы.ПС;
	КонецЕсли;
	
	Возврат РезультатТекст;
	
КонецФункции

Функция ВыполнитьУниверсальныйЗапрос(АдресСервиса, ТекстЗапроса, ПараметрыЗапроса = Неопределено) Экспорт
	
	ПараметрыАдреса = РазобратьАдрес(АдресСервиса);
	
	// Если адрес не содержит пути API, запрос отправляется в корень сервера.
	ПутьAPI = "/"; // Ставим слеш по умолчанию (корень сервера)
	
	// Проверяем, вернула ли функция ключ "ПутьAPI"
	НайденныйПуть = "";
	Если ПараметрыАдреса.Свойство("ПутьAPI", НайденныйПуть) Тогда
		// Если путь есть и он не пустой, берем его. Иначе оставляем слеш "/"
		Если Не ПустаяСтрока(НайденныйПуть) Тогда
			ПутьAPI = НайденныйПуть;
		КонецЕсли;
	КонецЕсли; 
	
	ЧистыйАдресСервера = ПараметрыАдреса.Хост;
	Если ПараметрыАдреса.Свойство("Порт") И ЗначениеЗаполнено(ПараметрыАдреса.Порт) Тогда
		// ЧГ=0 отключает разделение групп цифр, чтобы получилось "8080", а не "8 080"
		ЧистыйАдресСервера = ЧистыйАдресСервера + ":" + Формат(ПараметрыАдреса.Порт, "ЧГ=0"); 
	КонецЕсли;	
	
	// 1. Упаковываем параметры в нужный формат для сервера
	МассивПараметров = Новый Массив;	
	Если ПараметрыЗапроса <> Неопределено И ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
		Для каждого Параметр Из ПараметрыЗапроса Цикл
			
			// Если значение параметра — структура с ключом "UUID", упаковываем как ссылку
			Если ТипЗнч(Параметр.Значение) = Тип("Структура") И Параметр.Значение.Свойство("UUID") Тогда
				
				НовыйПараметр = Новый Структура("Имя, Значение, ТипМетаданных");
				НовыйПараметр.Имя = Параметр.Ключ;
				НовыйПараметр.Значение = Строка(Параметр.Значение.UUID);
				
				ВходящийТип = "";
				Если Параметр.Значение.Свойство("ТипМетаданных", ВходящийТип) Тогда
					НовыйПараметр.ТипМетаданных = ВходящийТип;
				КонецЕсли;
				
				МассивПараметров.Добавить(НовыйПараметр);
				
			Иначе
				// Стандартный простой параметр (строка, число, дата)
				МассивПараметров.Добавить(Новый Структура("Имя, Значение", Параметр.Ключ, Параметр.Значение));
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("ТекстЗапроса", ТекстЗапроса);
	Данные.Вставить("ПараметрыЗапроса", МассивПараметров);
		
	// Ошибки сети и неожиданные HTTP-статусы передаются вызывающему коду исключением.
	
	ДанныеОтвета = AI_Core_ОбменСервисом.ВыполнитьPOST(ЧистыйАдресСервера, ПутьAPI, Данные);
	
	// 3. Проверяем результат и собираем Таблицу Значений
	// Успешный HTTP-статус ещё не гарантирует наличие ожидаемого поля result.
	Если ТипЗнч(ДанныеОтвета) = Тип("Структура") И ДанныеОтвета.Свойство("result") Тогда
		Возврат СоздатьТаблицуИзМассива(ДанныеОтвета.result);
	Иначе
		Возврат Новый ТаблицаЗначений; // Возвращаем пустую таблицу, если результата нет
	КонецЕсли;
	
КонецФункции

Функция СоздатьТаблицуИзМассива(МассивДанных)
	
	ТЗ = Новый ТаблицаЗначений;
	
	Если ТипЗнч(МассивДанных) <> Тип("Массив") Или МассивДанных.Количество() = 0 Тогда
		Возврат ТЗ; 
	КонецЕсли;
	
	// Создаем колонки, ориентируясь на ключи из первой строки ответа
	ПерваяСтрока = МассивДанных[0];
	Для каждого КлючИЗначение Из ПерваяСтрока Цикл
		ТЗ.Колонки.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	// Заполняем таблицу строками
	Для каждого ЭлементМассива Из МассивДанных Цикл
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции        


Функция ПолучитьДанныеОбъектаУПП(АдресСервиса, ИмяТаблицы, ПолеПоиска, ЗначениеПоиска) Экспорт
	
	// Формируем текст запроса. 
	// Мы запрашиваем саму ссылку. Функция на стороне УПП (ОписаниеСсылочногоТипа)
	// раскроет её реквизиты и табличные части с ограничением глубины вложенных ссылок.
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК ДанныеОбъекта
		|ИЗ
		|	" + ИмяТаблицы + " КАК Таблица
		|ГДЕ
		|	Таблица." + ПолеПоиска + " = &ЗначениеПоиска";
		
	// Подготавливаем параметры
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ЗначениеПоиска", ЗначениеПоиска);
	
	// Выполняем универсальный запрос
	
	ТаблицаРезультата = ВыполнитьУниверсальныйЗапрос(АдресСервиса, ТекстЗапроса, ПараметрыЗапроса);
	
	Если ТаблицаРезультата.Количество() > 0 Тогда
		// Структура содержит поддерживаемые реквизиты и ТЧ; вложенные ссылки раскрываются ограниченно.
		Возврат ТаблицаРезультата[0].ДанныеОбъекта; 
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции    

Функция ПолучитьДанныеОбъектаПоUUIDУПП(АдресСервиса, ИмяТаблицы, СтрокаUUID) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК ДанныеОбъекта
		|ИЗ
		|	" + ИмяТаблицы + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &СсылкаНаОбъект";
		
	// Создаем структуру-дескриптор для передачи ссылки
	ПараметрыСсылка = Новый Структура;
	ПараметрыСсылка.Вставить("UUID", СтрокаUUID);
	ПараметрыСсылка.Вставить("ТипМетаданных", ИмяТаблицы);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СсылкаНаОбъект", ПараметрыСсылка);
	
	// Выполняем универсальный запрос
	ТаблицаРезультата = ВыполнитьУниверсальныйЗапрос(АдресСервиса, ТекстЗапроса, ПараметрыЗапроса);
	
	Если ТаблицаРезультата.Количество() > 0 Тогда
		// ОписаниеСсылочногоТипа возвращает структуру объекта с ограниченной глубиной вложенных ссылок.
		Возврат ТаблицаРезультата[0].ДанныеОбъекта; 
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции