Функция ЭтоПримитивДляJSON(Значение) Экспорт
    ТипЗ = ТипЗнч(Значение);
    Возврат ТипЗ = Тип("Строка")
        ИЛИ ТипЗ = Тип("Число")
        ИЛИ ТипЗ = Тип("Булево");
КонецФункции                                      

Функция ЭтоДата(Значение) Экспорт
    Возврат ТипЗнч(Значение) = Тип("Дата");
КонецФункции

Функция СериализоватьЗначениеJSON(Значение) Экспорт
    Если Значение = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Если ЭтоПримитивДляJSON(Значение) Тогда
        Возврат Значение;
    КонецЕсли;
    
    Если ЭтоДата(Значение) Тогда
        Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
    КонецЕсли;
    
    Попытка
        Возврат Строка(Значение);
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция ПолучитьУИДСсылки(Значение) Экспорт
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    
    Попытка
        Если Значение = Null Тогда
            Возврат "";
        КонецЕсли;
    Исключение
    КонецПопытки;
    
    Попытка
        Возврат Строка(Значение.УникальныйИдентификатор());       
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Процедура ДобавитьПолеВСериализацию(СтруктураПолей, ИмяПоля, ЗначениеПоля) Экспорт
    СтруктураПолей.Вставить(ИмяПоля, СериализоватьЗначениеJSON(ЗначениеПоля));
    
    УИД = ПолучитьУИДСсылки(ЗначениеПоля);
    Если ЗначениеЗаполнено(УИД) Тогда
        СтруктураПолей.Вставить(ИмяПоля + "_УИД", УИД);
    КонецЕсли;
КонецПроцедуры


Функция ПодготовитьОбъектКОтправке(Объект) Экспорт
    Результат = Новый Структура;
    Мета = Объект.Метаданные(); 
	МетаРеквизиты = Мета.Реквизиты;
    
    // Системный блок
    Результат.Вставить("source_config", Метаданные.Имя);
    Результат.Вставить("metadata_name", Мета.ПолноеИмя());
    Результат.Вставить("ref_uuid", Строка(Объект.Ссылка.УникальныйИдентификатор()));
    
    ЭтоДокумент = Метаданные.Документы.Содержит(Мета);
    ЭтоСправочник = Метаданные.Справочники.Содержит(Мета);
    
    Если ЭтоДокумент Тогда
        Результат.Вставить("date", Формат(Объект.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss")); 
        Результат.Вставить("number", Объект.Номер); 
        Результат.Вставить("posted", Объект.Проведен); 
    ИначеЕсли ЭтоСправочник Тогда
        Результат.Вставить("target_name", Объект.Наименование);
        Результат.Вставить("target_uuid", Строка(Объект.Ссылка.УникальныйИдентификатор())); 
    	Результат.Вставить("date", '00010101');  
    
		
		Если Мета.Имя = "Организации" Тогда
            Результат.Вставить("number", Объект.ИНН); 
            Результат.Вставить("organization", Объект.Наименование);  
			Результат.Вставить("inn", Объект.ИНН);
        Иначе 
			// Попытка используется на случай, если у справочника отключено поле Код
            Попытка
                Результат.Вставить("number", Объект.Код);
            Исключение
                Результат.Вставить("number", "");
            КонецПопытки;

        КонецЕсли;
        
        // Передаём признак группы и путь родителей иерархического справочника.
        Если Мета.Иерархический Тогда
            Результат.Вставить("is_folder", Объект.ЭтоГруппа); // Признак группы участвует в сопоставлении объектов.
            
            Путь = "";
            ТекРодитель = Объект.Родитель;
            Пока ЗначениеЗаполнено(ТекРодитель) Цикл
                Путь = Строка(ТекРодитель) + " / " + Путь;
                ТекРодитель = ТекРодитель.Родитель;
            КонецЦикла;
            Результат.Вставить("hierarchy", Путь);
		КонецЕсли;
	КонецЕсли;    
	
	ИНН_Значение = "";
	Если МетаРеквизиты.Найти("Контрагент") <> Неопределено Тогда
        Если ЗначениеЗаполнено(Объект.Контрагент) Тогда	
        	ИНН_Значение = СокрЛП(Объект.Контрагент.ИНН); 
		КонецЕсли;
	КонецЕсли;
	Результат.Вставить("inn", ИНН_Значение);
			
    // Пользовательские реквизиты шапки; стандартные поля переданы отдельно выше.
    Поля = Новый Структура;
    Для Каждого Рекв Из Мета.Реквизиты Цикл
        Поля.Вставить(нрег(Рекв.Имя), СериализоватьЗначениеJSON(Объект[Рекв.Имя]));
    КонецЦикла;
    Результат.Вставить("raw_fields", Поля);
    
    // Имена табличных частей и колонок приводятся к нижнему регистру.
    ТабличныеЧасти = Новый Структура;
    Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
        МассивСтрок = Новый Массив;
        Для Каждого Стр Из Объект[ТЧ.Имя] Цикл         
            СтрJSON = Новый Структура;
            Для Каждого Кол Из ТЧ.Реквизиты Цикл
                ДобавитьПолеВСериализацию(СтрJSON, нрег(Кол.Имя), Стр[Кол.Имя]);
            КонецЦикла;
            МассивСтрок.Добавить(СтрJSON);
        КонецЦикла;
        ТабличныеЧасти.Вставить(нрег(ТЧ.Имя), МассивСтрок);
    КонецЦикла;
    Результат.Вставить("table_parts", ТабличныеЧасти);
    
    Возврат Результат;
КонецФункции

 
Функция ДесериализоватьИзJSON(Данные) Экспорт
    
    Если ПустаяСтрока(Данные) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Данные);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
    
КонецФункции


Функция СериализоватьВJSONСтроку(Данные) Экспорт       
	
	Если ПустаяСтрока(Данные) Тогда
        Возврат Неопределено;
    КонецЕсли;
	
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();   
	
	Настройки = Новый НастройкиСериализацииJSON;
    Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
    
    ЗаписатьJSON(ЗаписьJSON, Данные, Настройки);
	Возврат ЗаписьJSON.Закрыть(); 
	
КонецФункции


Функция ПодготовитьВнешнийОбъектКОтправке(UUIDСтрока, ИмяМетаданных, База, ТекущееСоединение = Неопределено) Экспорт
    
    Результат = Новый Структура;
    СтруктураПолей = Новый Структура;
    СтруктураТабличныхЧастей = Новый Структура;
    
    ИспользоватьПереданноеСоединение = (ТекущееСоединение <> Неопределено);
    
    Если ИспользоватьПереданноеСоединение Тогда
        Соединение = ТекущееСоединение;
    Иначе
        // Подключаемся к переданной базе, если вызов пришел извне без готового соединения
        Соединение = AI_Core_ИнтеграцияУПП.ПодключитьсяКВнешнейБазе(База);
        Если Соединение = Неопределено Тогда
            ВызватьИсключение "Не удалось подключиться к внешней базе: " + Строка(База);
        КонецЕсли;
    КонецЕсли;
    
    ЧастиИмени = СтрРазделить(ИмяМетаданных, ".");
    ТипОбъекта = ЧастиИмени[0]; 
    ИмяОбъекта = ЧастиИмени[1];
    
    Менеджер = ?(ТипОбъекта = "Справочник", Соединение.Справочники, Соединение.Документы);
    
    // Получаем COM-объект
    СсылкаВнешняя = Менеджер[ИмяОбъекта].GetRef(Соединение.NewObject("УникальныйИдентификатор", UUIDСтрока));
    COMОбъект = СсылкаВнешняя.ПолучитьОбъект();
    
    Если COMОбъект = Неопределено Тогда
        ВызватьИсключение "Объект не найден во внешней базе (возможно был удален). UUID: " + UUIDСтрока;
    КонецЕсли;
    
    МетаВнешняя = COMОбъект.Метаданные();
    ИмяКонфы = Соединение.String(Соединение.Метаданные.Имя); 
    
    Результат.Вставить("source_config", ИмяКонфы); 
    Результат.Вставить("metadata_name", ИмяМетаданных);
    Результат.Вставить("ref_uuid", UUIDСтрока);
    
    Если ТипОбъекта = "Документ" Тогда
        Результат.Вставить("date", Формат(COMОбъект.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        Результат.Вставить("number", Соединение.String(COMОбъект.Номер));
        Результат.Вставить("posted", COMОбъект.Проведен);
    ИначеЕсли ТипОбъекта = "Справочник" Тогда
        Результат.Вставить("target_name", Соединение.String(COMОбъект.Наименование));
        Результат.Вставить("target_uuid", UUIDСтрока); 
        Результат.Вставить("date", "00010101");    
		
		Если ИмяОбъекта = "Организации" Тогда
            Результат.Вставить("number", Соединение.String(COMОбъект.ИНН));
            Результат.Вставить("organization", Соединение.String(COMОбъект.Наименование));
            Результат.Вставить("inn", Соединение.String(COMОбъект.ИНН));
        Иначе
            // Попытка используется на случай, если у справочника отключено поле Код
            Попытка
                Результат.Вставить("number", Соединение.String(COMОбъект.Код));
            Исключение
                Результат.Вставить("number", "");
            КонецПопытки;
        КонецЕсли;
    КонецЕсли;
    
    // Реквизиты внешнего объекта передаются строками с именами в нижнем регистре.
    Для Каждого Рекв Из МетаВнешняя.Реквизиты Цикл
        СтруктураПолей.Вставить(нрег(Рекв.Имя), Соединение.String(COMОбъект[Рекв.Имя]));
    КонецЦикла;
    
    // Собираем строки табличных частей внешнего объекта.
    Для Каждого МетаТЧ Из МетаВнешняя.ТабличныеЧасти Цикл
        ИмяТЧ = МетаТЧ.Имя;
        МассивСтрокТЧ = Новый Массив;
        
        ТЧОбъекта = COMОбъект[ИмяТЧ]; // Получаем коллекцию строк ТЧ
        
        Для Каждого СтрокаТЧ Из ТЧОбъекта Цикл
            СтруктураОднойСтроки = Новый Структура;
            
            Для Каждого РеквТЧ Из МетаТЧ.Реквизиты Цикл
                // Строковое представление формируется в контексте внешней базы.
                СтруктураОднойСтроки.Вставить(нрег(РеквТЧ.Имя), Соединение.String(СтрокаТЧ[РеквТЧ.Имя]));
            КонецЦикла;
            
            МассивСтрокТЧ.Добавить(СтруктураОднойСтроки);
        КонецЦикла;
        
        // Вставляем собранный массив строк в структуру табличных частей
        СтруктураТабличныхЧастей.Вставить(нрег(ИмяТЧ), МассивСтрокТЧ);
    КонецЦикла;
    
    // Освобождаем локальную переменную только для созданного здесь соединения; переданное использует вызывающий код.
    Если Не ИспользоватьПереданноеСоединение Тогда
        Соединение = Неопределено; 
    КонецЕсли;
    
    Результат.Вставить("raw_fields", СтруктураПолей);
    Результат.Вставить("table_parts", СтруктураТабличныхЧастей);
    
    Возврат Результат;
    
КонецФункции
 