Функция ПроверитьСервис(АдресСервиса) Экспорт
    
    Если ПустаяСтрока(АдресСервиса) Тогда
        Возврат "Не инициализирован адрес AI-сервиса";
    КонецЕсли;
    
    Попытка
        ОтветСервиса = Расш_Банк_ОбменСервисом.ВыполнитьGET(АдресСервиса, "/api/health");
        СтрокаОтветаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ОтветСервиса);
        
    Исключение
        ОтветСервиса = ОписаниеОшибки();
    КонецПопытки;
    
    Возврат ОтветСервиса;
    
КонецФункции

Функция ПроанализироватьОбъект(АдресСервиса, ОбъектИлиСсылка, ИмяОбъектаМетаданных, База=Неопределено, СценарийАнализа = "АнализОбъекта") Экспорт
    
    Если ПустаяСтрока(АдресСервиса) Тогда
        ВызватьИсключение "Не инициализирован адрес AI-сервиса";
    КонецЕсли;
    
    ТипПараметра = ТипЗнч(ОбъектИлиСсылка);
    ЭтоВнешняяБаза = ЗначениеЗаполнено(База) И ТипПараметра = Тип("Строка");
    
    Если ЭтоВнешняяБаза Тогда
        // Для внешней базы у нас нет локального объекта, СсылкаОбъекта — это просто UUID (Строка)
        СсылкаОбъекта = ОбъектИлиСсылка;
        ДанныеЗапроса = Расш_Банк_Сериализация.ПодготовитьВнешнийОбъектКОтправке(ОбъектИлиСсылка, ИмяОбъектаМетаданных, База);
    Иначе
        // Локальная ссылка преобразуется в объект для чтения реквизитов.
        Если ОбщегоНазначения.ЭтоСсылка(ТипПараметра) Тогда
            СсылкаОбъекта = ОбъектИлиСсылка;
            ОбъектДляАнализа = СсылкаОбъекта.ПолучитьОбъект();
        Иначе
            ОбъектДляАнализа = ОбъектИлиСсылка;
            СсылкаОбъекта = ОбъектДляАнализа.Ссылка;
        КонецЕсли;
        
        ДанныеЗапроса = Расш_Банк_Сериализация.ПодготовитьОбъектКОтправке(ОбъектДляАнализа);
    КонецЕсли;
    
    УИДЗапроса = Новый УникальныйИдентификатор;
    СтрокаЗапросаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ДанныеЗапроса);
    ХешЗапроса = РассчитатьХешЗапроса(СтрокаЗапросаJSON);
    ДанныеЗапроса.Вставить("hash", ХешЗапроса);
    
    ИмяБазыДляЛога = "";
    Если ДанныеЗапроса.Свойство("source_config") Тогда
        ИмяБазыДляЛога = ДанныеЗапроса.source_config;
    КонецЕсли;
    
    Попытка
        ОтветСервиса = Расш_Банк_ОбменСервисом.ВыполнитьPOST(АдресСервиса, "/api/analyze_document", ДанныеЗапроса);
        СтрокаОтветаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ОтветСервиса);
        
        СтатусДляЗаписи = Перечисления.Расш_Банк_СтатусыАнализаОбъекта.Успешно;
        
        УидРезультата = "";
        Если ТипЗнч(ОтветСервиса) = Тип("Структура") И ОтветСервиса.Свойство("suggested_target_uuid") Тогда
            УидРезультата = Строка(ОтветСервиса.suggested_target_uuid);
        КонецЕсли;
        
        // Если UUID пустой или состоит из нулей — значит сервер ничего не нашел
        Если ПустаяСтрока(УидРезультата) ИЛИ УидРезультата = "00000000-0000-0000-0000-000000000000" Тогда
            СтатусДляЗаписи = Перечисления.Расш_Банк_СтатусыАнализаОбъекта.НеНайдено;
        КонецЕсли;
        
        ЗаписатьРезультатАнализа(
            СсылкаОбъекта,
            УИДЗапроса,
            СтатусДляЗаписи,
            ПолучитьРезультатИзОтвета(ОтветСервиса),
            СтрокаЗапросаJSON,
            СтрокаОтветаJSON,
            ХешЗапроса,
            "",
            СценарийАнализа,
            АдресСервиса,
            ПолучитьВерсиюМоделиИзОтвета(ОтветСервиса),
            ИмяБазыДляЛога
            );
        
        Возврат ОтветСервиса;
        
    Исключение
        
        ЗаписатьРезультатАнализа(
            СсылкаОбъекта,
            УИДЗапроса,
            Перечисления.Расш_Банк_СтатусыАнализаОбъекта.Ошибка,
            "",
            СтрокаЗапросаJSON,
            "",
            ХешЗапроса,
            ОписаниеОшибки(),
            СценарийАнализа,
            АдресСервиса,
            "",
            ИмяБазыДляЛога
            );
        
        ВызватьИсключение;
        
    КонецПопытки;
    
КонецФункции

Процедура ЗаписатьРезультатАнализа(
        ОбъектСсылка,
        УИДАнализа,
        Статус,
        Результат,
        ЗапросJSON,
        ОтветJSON,
        ХешЗапроса,
        ТекстОшибки,
        СценарийАнализа,
        ИспользованныйСервис,
        ВерсияМодели,
        ИмяБазы = ""
        ) Экспорт
    
    МенеджерЗаписи = РегистрыСведений.Расш_Банк_РезультатыАнализаОбъектов.СоздатьМенеджерЗаписи();
    
    МенеджерЗаписи.Период = ТекущаяДата();
    МенеджерЗаписи.ОбъектСсылка = ОбъектСсылка;
    МенеджерЗаписи.УИДАнализа = УИДАнализа;
    
    МенеджерЗаписи.Статус = Статус;
    МенеджерЗаписи.Результат = Результат;
    МенеджерЗаписи.ЗапросJSON = ЗапросJSON;
    МенеджерЗаписи.ОтветJSON = ОтветJSON;
    МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
    МенеджерЗаписи.База = ИмяБазы;
    МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
    
    МенеджерЗаписи.ХешЗапроса = ХешЗапроса;
    МенеджерЗаписи.СценарийАнализа = СценарийАнализа;
    МенеджерЗаписи.ВерсияМодели = ВерсияМодели;
    
    МенеджерЗаписи.Записать();
    
КонецПроцедуры

Функция ПолучитьРезультатИзОтвета(ОтветСервиса) Экспорт
    
    Если ТипЗнч(ОтветСервиса) <> Тип("Структура") Тогда
        Возврат "";
    КонецЕсли;
    
    Если ОтветСервиса.Свойство("result") Тогда
        Возврат Строка(ОтветСервиса.result);
    КонецЕсли;
    
    Возврат "";
    
КонецФункции

Функция ПолучитьВерсиюМоделиИзОтвета(ОтветСервиса) Экспорт
    
    Если ТипЗнч(ОтветСервиса) <> Тип("Структура") Тогда
        Возврат "";
    КонецЕсли;
    
    Если ОтветСервиса.Свойство("model_version") Тогда
        Возврат Строка(ОтветСервиса.model_version);
    КонецЕсли;
    
    Возврат "";
    
КонецФункции

Функция РассчитатьХешЗапроса(СтрокаЗапросаJSON) Экспорт
    
    Если ПустаяСтрока(СтрокаЗапросаJSON) Тогда
        Возврат "";
    КонецЕсли;
    
    Данные = ПолучитьДвоичныеДанныеИзСтроки(СтрокаЗапросаJSON, КодировкаТекста.UTF8);
    
    ХешОбъект = Новый ХешированиеДанных(ХешФункция.SHA256);
    ХешОбъект.Добавить(Данные);
    
    Результат = Строка(ХешОбъект.ХешСумма);
    
    ХешСтрока = СтрЗаменить(Строка(Результат), " ", "");
    
    Возврат НРег(ХешСтрока);
    
КонецФункции

Функция ВыгрузитьИсториюЗаПериод(АдресСервиса, ИмяОбъектаМетаданных, ДатаНач, ДатаКон, База = Неопределено) Экспорт
    
    ЭтоВнешняяБаза = ЗначениеЗаполнено(База);
    Результат = Новый Структура;
    Пакет = Новый Массив;
    
    Если ЭтоВнешняяБаза Тогда
        // Одно COM-соединение используется для всей выгрузки за период.
        Соединение = Расш_Банк_ИнтеграцияУПП.ПодключитьсяКВнешнейБазе(База);
        Если Соединение = Неопределено Тогда
            ВызватьИсключение "Не удалось подключиться к внешней базе: " + Строка(База);
        КонецЕсли;
        Запрос = Соединение.NewObject("Запрос");
    Иначе
        Запрос = Новый Запрос;
    КонецЕсли;
    
    ТекстЗапроса = "ВЫБРАТЬ Ссылка ИЗ " + ИмяОбъектаМетаданных + " КАК ДанныеОбъекта";
    
    // Фильтр по дате только для документов
    Если СтрНачинаетсяС(ИмяОбъектаМетаданных, "Документ.") Тогда
        ТекстЗапроса = ТекстЗапроса + " ГДЕ ДанныеОбъекта.Дата МЕЖДУ &ДатаНач И &ДатаКон";
        Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНач));
        Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаКон));
    КонецЕсли;
    
    Запрос.Текст = ТекстЗапроса;
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        
        Если ЭтоВнешняяБаза Тогда
            СтрокаУИД = Соединение.String(Выборка.Ссылка.УникальныйИдентификатор());
            // Передаем открытое Соединение 4-м параметром, чтобы не открывать COM на каждый объект
            ДанныеОбъекта = Расш_Банк_Сериализация.ПодготовитьВнешнийОбъектКОтправке(СтрокаУИД, ИмяОбъектаМетаданных, База, Соединение);
        Иначе
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            ДанныеОбъекта = Расш_Банк_Сериализация.ПодготовитьОбъектКОтправке(Объект);
        КонецЕсли;
        
        СтрокаЗапросаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ДанныеОбъекта);
        ХешЗапроса = РассчитатьХешЗапроса(СтрокаЗапросаJSON);
        ДанныеОбъекта.Вставить("hash", ХешЗапроса);
        
        Пакет.Добавить(ДанныеОбъекта);
        
        // Размер пакета ограничен 200 объектами.
        Если Пакет.Количество() >= 200 Тогда
            РезОтвет = ОтправитьПакетИстории(АдресСервиса, Пакет, База);
            ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, РезОтвет, Ложь);
            Пакет.Очистить();
        КонецЕсли;
    КонецЦикла;
    
    // Доотправка остатков
    Если Пакет.Количество() > 0 Тогда
        РезОтвет = ОтправитьПакетИстории(АдресСервиса, Пакет, База);
        ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, РезОтвет, Ложь);
        Пакет.Очистить();
    КонецЕсли;
    
    // Освобождаем локальную переменную соединения после выгрузки.
    Если ЭтоВнешняяБаза И Соединение <> Неопределено Тогда
        Соединение = Неопределено;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

Функция ОтправитьПакетИстории(АдресСервиса, Пакет, База = Неопределено) Экспорт
    
    Тело = Новый Структура("objects", Пакет);
    
    УИДСессии = Новый УникальныйИдентификатор;
    
    КартаОбъектов = Новый Соответствие;
    Для Каждого ДанныеИзПакета Из Пакет Цикл
        КартаОбъектов.Вставить(ДанныеИзПакета.ref_uuid, ДанныеИзПакета);
    КонецЦикла;
    
    ЭтоВнешняяБаза = ЗначениеЗаполнено(База);
    
    Попытка
        ОтветСервиса = Расш_Банк_ОбменСервисом.ВыполнитьPOST(АдресСервиса, "/api/upload_history", Тело);
        СтрокаОтветаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ОтветСервиса);
        
        Если ОтветСервиса <> Неопределено И ОтветСервиса.Свойство("results") Тогда
            
            Модель = ПолучитьВерсиюМоделиИзОтвета(ОтветСервиса);
            
            Для Каждого РезультатОбъекта Из ОтветСервиса.results Цикл
                
                Если ЭтоВнешняяБаза Тогда
                    СсылкаНаОбъект = РезультатОбъекта.ref_uuid;
                Иначе
                    СсылкаНаОбъект = ПолучитьСсылкуУниверсально(РезультатОбъекта.metadata_name, РезультатОбъекта.ref_uuid);
                    
                    Если СсылкаНаОбъект = Неопределено Тогда
                        СсылкаНаОбъект = РезультатОбъекта.ref_uuid;
                    КонецЕсли;
                КонецЕсли;
                
                ДанныеОбъекта = КартаОбъектов.Получить(РезультатОбъекта.ref_uuid);
                
                ИндивидуальныйЗапросJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(ДанныеОбъекта);
                ИндивидуальныйОтветJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(РезультатОбъекта);
                
                СтатусАнализа = ?(РезультатОбъекта.status = "success" ИЛИ РезультатОбъекта.status = "skipped",
                    Перечисления.Расш_Банк_СтатусыАнализаОбъекта.Успешно,
                    Перечисления.Расш_Банк_СтатусыАнализаОбъекта.Ошибка);
                
                ЗаписатьРезультатАнализа(
                    СсылкаНаОбъект,
                    УИДСессии,
                    СтатусАнализа,
                    РезультатОбъекта.message,
                    ИндивидуальныйЗапросJSON,
                    ИндивидуальныйОтветJSON,
                    ДанныеОбъекта.hash,
                    "",
                    "ВыгрузкаИстории",
                    АдресСервиса,
                    Модель,
                    ДанныеОбъекта.source_config
                    );
            КонецЦикла;
            
        КонецЕсли;
        
        Возврат ОтветСервиса;
        
    Исключение
        
        // 23.10.2026: при сбое HTTP данные берутся из пакета, ответ сервиса может отсутствовать.
        Для Каждого ОбъектИзПакета Из Пакет Цикл
            
            Если ЭтоВнешняяБаза Тогда
                СсылкаНаОбъект = ОбъектИзПакета.ref_uuid;
            Иначе
                СсылкаНаОбъект = ПолучитьСсылкуУниверсально(ОбъектИзПакета.metadata_name, ОбъектИзПакета.ref_uuid);
                
                Если СсылкаНаОбъект = Неопределено Тогда
                    СсылкаНаОбъект = ОбъектИзПакета.ref_uuid;
                КонецЕсли;
            КонецЕсли;
            
            ЗаписатьРезультатАнализа(
                СсылкаНаОбъект,
                УИДСессии,
                Перечисления.Расш_Банк_СтатусыАнализаОбъекта.Ошибка,
                "Сервис недоступен (ошибка сети)",
                "", "", "",
                ОписаниеОшибки(),
                "ВыгрузкаИстории",
                АдресСервиса,
                "",
                ОбъектИзПакета.source_config
                );
        КонецЦикла;
        ВызватьИсключение;
        
    КонецПопытки;
    
КонецФункции

Функция ПолучитьСсылкуУниверсально(ПолноеИмяМетаданных, СтрUUID) Экспорт
    
    Если ПустаяСтрока(СтрUUID) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    МетаОбъект = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных);
    Если МетаОбъект = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Попытка
        УИД = Новый УникальныйИдентификатор(СтрUUID);
        
        МассивЧастей = СтрРазделить(ПолноеИмяМетаданных, ".");
        
        Если МассивЧастей.Количество() < 2 Тогда
            Возврат Неопределено;
        КонецЕсли;
        
        ТипКласса = МассивЧастей[0];
        ИмяОбъекта = МассивЧастей[1];
        
        Если ТипКласса = "Документ" Тогда
            Возврат Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
            
        ИначеЕсли ТипКласса = "Справочник" Тогда
            Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
            
        КонецЕсли;
        
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    
    Возврат Неопределено;
    
КонецФункции
