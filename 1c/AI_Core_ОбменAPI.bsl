Функция ОписаниеСсылочногоТипа(Ссылка, Стэк = Неопределено, КэшТипов = Неопределено) 
	
	Если Ссылка = Неопределено Или Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	ТекущийСтэк = ?(Стэк = Неопределено, Новый Массив, Стэк);
	
	// Единожды инициализируем кэш типов для ускорения работы
	Если КэшТипов = Неопределено Тогда
		КэшТипов = Новый Структура;
		КэшТипов.Вставить("Документы", Документы.ТипВсеСсылки());
		КэшТипов.Вставить("Справочники", Справочники.ТипВсеСсылки());
		КэшТипов.Вставить("ПВХ", ПланыВидовХарактеристик.ТипВсеСсылки());
		КэшТипов.Вставить("ПланыСчетов", ПланыСчетов.ТипВсеСсылки());
		КэшТипов.Вставить("Перечисления", Перечисления.ТипВсеСсылки());
		
		ПростыеТипы = Новый Массив;
		ПростыеТипы.Добавить(Тип("Булево"));
		ПростыеТипы.Добавить(Тип("Дата"));
		ПростыеТипы.Добавить(Тип("Строка"));
		ПростыеТипы.Добавить(Тип("Число"));
		КэшТипов.Вставить("ПростыеТипы", ПростыеТипы);
	КонецЕсли;
	
	ВыгружатьТЧ = Ложь;
	Результат = Новый Структура;        
	
	ТипСсылки = ТипЗнч(Ссылка);
	Если КэшТипов.Документы.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Результат.Вставить("id", ""+Ссылка.УникальныйИдентификатор());
		Результат.Вставить("Номер", Ссылка.Номер);
		Результат.Вставить("Дата", Ссылка.Дата);
		Результат.Вставить("ПометкаУдаления", Ссылка.ПометкаУдаления);
		ВыгружатьТЧ = Истина;
	ИначеЕсли КэшТипов.Справочники.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Результат.Вставить("id", ""+Ссылка.УникальныйИдентификатор());
		Результат.Вставить("Родитель", ""+Ссылка.Родитель.УникальныйИдентификатор());
		Результат.Вставить("Код", Ссылка.Код);
		Результат.Вставить("ЭтоГруппа", Ссылка.ЭтоГруппа);
		Результат.Вставить("ПометкаУдаления", Ссылка.ПометкаУдаления);
		Результат.Вставить("Наименование", Ссылка.Наименование);
		ВыгружатьТЧ = Истина;
	ИначеЕсли КэшТипов.ПВХ.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Результат.Вставить("id", ""+Ссылка.УникальныйИдентификатор());
		Результат.Вставить("Родитель", ""+Ссылка.Родитель.УникальныйИдентификатор());
		Результат.Вставить("Код", Ссылка.Код);
		Результат.Вставить("ЭтоГруппа", Ссылка.ЭтоГруппа);
		Результат.Вставить("ПометкаУдаления", Ссылка.ПометкаУдаления);
		Результат.Вставить("Наименование", Ссылка.Наименование);
	ИначеЕсли КэшТипов.ПланыСчетов.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Результат.Вставить("id", ""+Ссылка.УникальныйИдентификатор());
		Результат.Вставить("Родитель", ""+Ссылка.Родитель.УникальныйИдентификатор());
		Результат.Вставить("Код", Ссылка.Код);
		Результат.Вставить("ПометкаУдаления", Ссылка.ПометкаУдаления);
		Результат.Вставить("Наименование", Ссылка.Наименование);
	КонецЕсли;                                 
	
	// Защита от бесконечного зацикливания при перекрестных ссылках
	Если ТекущийСтэк.Найти(Ссылка) <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;    
	
	// Вложенные документы не раскрываются; остальные ссылки раскрываются не глубже одного уровня.
	Если ТекущийСтэк.Количество() > 0 Тогда
		
		// Для вложенного документа возвращаем только базовые поля, сформированные выше.
		Если КэшТипов.Документы.СодержитТип(ТипЗнч(Ссылка)) Тогда
			Возврат Результат;
		КонецЕсли;
		
		// При глубине больше одного уровня возвращаем только базовые поля ссылки.
		Если ТекущийСтэк.Количество() > 1 Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийСтэк.Добавить(Ссылка);
	
	// Обход реквизитов шапки
	Реквизиты = Ссылка.Метаданные().Реквизиты;
	Для каждого Реквизит из Реквизиты Цикл
		Значение = Ссылка[Реквизит.Имя];
		Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
			Продолжить;
		ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
			Результат.Вставить(Реквизит.Имя, ""+Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Результат.Вставить(Реквизит.Имя, Формат(Значение, "ДФ=dd.MM.yyyy"));
		ИначеЕсли КэшТипов.Документы.СодержитТип(ТипЗнч(Значение)) Тогда
			Результат.Вставить(Реквизит.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
		ИначеЕсли КэшТипов.Справочники.СодержитТип(ТипЗнч(Значение)) Тогда
			Результат.Вставить(Реквизит.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
		ИначеЕсли КэшТипов.ПВХ.СодержитТип(ТипЗнч(Значение)) Тогда
			Результат.Вставить(Реквизит.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
		ИначеЕсли КэшТипов.ПланыСчетов.СодержитТип(ТипЗнч(Значение)) Тогда
			Результат.Вставить(Реквизит.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
		ИначеЕсли КэшТипов.Перечисления.СодержитТип(ТипЗнч(Значение)) Тогда
			Результат.Вставить(Реквизит.Имя, Строка(Значение));
		ИначеЕсли КэшТипов.ПростыеТипы.Найти(ТипЗнч(Значение)) <> Неопределено Тогда
			Результат.Вставить(Реквизит.Имя, XMLСтрока(Значение));
		КонецЕсли;
	КонецЦикла;
	
	// Обход Табличных частей
	Если ВыгружатьТЧ Тогда  
		ТабличныеЧасти = Ссылка.Метаданные().ТабличныеЧасти;
		Для каждого ТЧ из ТабличныеЧасти Цикл
			ДанныеТЧ = Новый Массив;
			Для каждого СтрокаТЧ из Ссылка[ТЧ.Имя] Цикл
				РезультатСтрокаТЧ = Новый Структура;        
				Для каждого РеквизитТЧ из ТЧ.Реквизиты Цикл
					Значение = СтрокаТЧ[РеквизитТЧ.Имя];
					Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
						Продолжить;
					ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, ""+Значение);
					ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, Формат(Значение, "ДФ=dd.MM.yyyy"));
					ИначеЕсли КэшТипов.Документы.СодержитТип(ТипЗнч(Значение)) Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
					ИначеЕсли КэшТипов.Справочники.СодержитТип(ТипЗнч(Значение)) Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
					ИначеЕсли КэшТипов.ПВХ.СодержитТип(ТипЗнч(Значение)) Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
					ИначеЕсли КэшТипов.ПланыСчетов.СодержитТип(ТипЗнч(Значение)) Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, ОписаниеСсылочногоТипа(Значение, ТекущийСтэк, КэшТипов));
					ИначеЕсли КэшТипов.Перечисления.СодержитТип(ТипЗнч(Значение)) Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, Строка(Значение));
					ИначеЕсли КэшТипов.ПростыеТипы.Найти(ТипЗнч(Значение)) <> Неопределено Тогда
						РезультатСтрокаТЧ.Вставить(РеквизитТЧ.Имя, XMLСтрока(Значение));
					КонецЕсли;
				КонецЦикла;
				ДанныеТЧ.Добавить(РезультатСтрокаТЧ);
			КонецЦикла;
			Результат.Вставить(ТЧ.Имя, ДанныеТЧ);
		КонецЦикла;
	КонецЕсли;
	
	Индекс = ТекущийСтэк.Найти(Ссылка);
	Если Индекс <> Неопределено Тогда
		ТекущийСтэк.Удалить(Индекс);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьВJSON(Значение) 
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, , , ЭкранированиеСимволовJSON.СимволыВнеASCII);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции 
                      
// 23.10.2026: имя функции соответствует обработчику POST /query в метаданных HTTP-сервиса.
Функция AI_Core_ЗапросДанных(Запрос) Экспорт
	
	Попытка
		
		// Тело HTTP-запроса ожидается в кодировке UTF-8.
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			ВызватьИсключение "Тело запроса пустое. Ожидаются данные в формате JSON.";
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);  
		ПараметрыЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Или Не ПараметрыЗапроса.Свойство("ТекстЗапроса") Тогда
			ВызватьИсключение "Некорректный формат тела запроса. Ожидается JSON с ключом 'ТекстЗапроса'.";
		КонецЕсли;
		
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.Текст = ПараметрыЗапроса.ТекстЗапроса;
		
		// Обработка параметров запроса
		МассивПараметров = Неопределено;
		Если ПараметрыЗапроса.Свойство("ПараметрыЗапроса", МассивПараметров) И ТипЗнч(МассивПараметров) = Тип("Массив") Тогда
			
			Для каждого Параметр из МассивПараметров Цикл
				ЗначениеПараметра = Параметр.Значение;
				
				// ПРОВЕРКА: Передан ли ссылочный UUID с указанием типа метаданных (для работы с ссылками)
				Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("ТипМетаданных") И ЗначениеЗаполнено(Параметр.ТипМетаданных) Тогда
					УИД = Новый УникальныйИдентификатор(ЗначениеПараметра);
					СсылкаНаОбъект = Неопределено;
					
					// Разделяем полное имя на класс и имя объекта метаданных.
					ПозТочки = Найти(Параметр.ТипМетаданных, ".");
					Если ПозТочки > 0 Тогда
						КлассМетаданных = Лев(Параметр.ТипМетаданных, ПозТочки - 1);
						ИмяОбъекта      = Сред(Параметр.ТипМетаданных, ПозТочки + 1);
						
						Если КлассМетаданных = "Справочник" Тогда
							СсылкаНаОбъект = Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
						ИначеЕсли КлассМетаданных = "Документ" Тогда
							СсылкаНаОбъект = Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
						ИначеЕсли КлассМетаданных = "ПланВидовХарактеристик" Или КлассМетаданных = "ПВХ" Тогда
							СсылкаНаОбъект = ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(УИД);
						ИначеЕсли КлассМетаданных = "ПланСчетов" Тогда
							СсылкаНаОбъект = ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(УИД);
						КонецЕсли;
					КонецЕсли;
					ЗначениеПараметра = СсылкаНаОбъект;
					
				// Парсинг дат стандарта ISO
				ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("Строка") И СтрДлина(ЗначениеПараметра) >= 19 
					И Сред(ЗначениеПараметра, 5, 1) = "-" И Сред(ЗначениеПараметра, 11, 1) = "T" Тогда
					Попытка
						ЗначениеПараметра = Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(ЗначениеПараметра, "-", ""), "T", ""), ":", ""));
					Исключение
					КонецПопытки;
				КонецЕсли;
				
				ЗапросДанных.УстановитьПараметр(Параметр.Имя, ЗначениеПараметра);
			КонецЦикла;
			
		КонецЕсли;		
			
		Данные = ЗапросДанных.Выполнить().Выгрузить();

		// Формирование результата с кэшированием типов
		КэшТипов = Новый Структура;
		КэшТипов.Вставить("Документы", Документы.ТипВсеСсылки());
		КэшТипов.Вставить("Справочники", Справочники.ТипВсеСсылки());
		КэшТипов.Вставить("ПВХ", ПланыВидовХарактеристик.ТипВсеСсылки());
		КэшТипов.Вставить("ПланыСчетов", ПланыСчетов.ТипВсеСсылки());
		КэшТипов.Вставить("Перечисления", Перечисления.ТипВсеСсылки());  
		
		ПростыеТипы = Новый Массив;
		ПростыеТипы.Добавить(Тип("Булево"));
		ПростыеТипы.Добавить(Тип("Дата"));
		ПростыеТипы.Добавить(Тип("Строка"));
		ПростыеТипы.Добавить(Тип("Число"));
		КэшТипов.Вставить("ПростыеТипы", ПростыеТипы);


		РезультатЗапроса = Новый Массив;  
		Для каждого СтрокаТЧ из Данные Цикл 
			НоваяСтрока = Новый Структура;
			Для каждого Колонка из Данные.Колонки Цикл    
				Значение = СтрокаТЧ[Колонка.Имя];
				ТипЗначения = ТипЗнч(Значение);
				
				Если ТипЗначения = Тип("Дата") Тогда
					НоваяСтрока.Вставить(Колонка.Имя, Формат(Значение, "ДФ=dd.MM.yyyy"));
				ИначеЕсли КэшТипов.Документы.СодержитТип(ТипЗначения) 
					   Или КэшТипов.Справочники.СодержитТип(ТипЗначения)
					   Или КэшТипов.ПВХ.СодержитТип(ТипЗначения)
					   Или КэшТипов.ПланыСчетов.СодержитТип(ТипЗначения) Тогда
					НоваяСтрока.Вставить(Колонка.Имя, ОписаниеСсылочногоТипа(Значение,, КэшТипов));
				ИначеЕсли КэшТипов.Перечисления.СодержитТип(ТипЗначения) Тогда
					НоваяСтрока.Вставить(Колонка.Имя, Строка(Значение));
				Иначе
					НоваяСтрока.Вставить(Колонка.Имя, XMLСтрока(Значение));
				КонецЕсли;
			КонецЦикла;
			РезультатЗапроса.Добавить(НоваяСтрока);
		КонецЦикла;
		
		// Успешный ответ
		ДанныеОтвета = Новый Структура("response, result", "ok", РезультатЗапроса);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(СериализоватьВJSON(ДанныеОтвета), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
	Исключение
		// Обработка ошибок
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		
		ОшибкаОтвета = Новый Структура("response, error", "error", ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки(СериализоватьВJSON(ОшибкаОтвета), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецПопытки;
	
	Возврат Ответ;   
	
КонецФункции

Функция ПодготовитьЗначениеКЗаписи(Значение)
	
	// Если передали структуру ссылки (Тип и Идентификатор или ПоляПоиска)
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Тип") Тогда
		
		ЧастиТипа = СтрРазделить(Значение.Тип, ".");
		Если ЧастиТипа.Количество() < 2 Тогда
			Возврат Значение;
		КонецЕсли;
		
		КлассОбъекта = ЧастиТипа[0];
		ИмяОбъекта   = ЧастиТипа[1];
		
		// 1. Обработка Перечислений (поиск по текстовому имени значения)
		Если КлассОбъекта = "Перечисление" Тогда
			ИмяЗначения = "";
			Если Значение.Свойство("Значение", ИмяЗначения) Или Значение.Свойство("Имя", ИмяЗначения) Тогда
				Попытка
					Возврат Перечисления[ИмяОбъекта][ИмяЗначения];
				Исключение
					Возврат Неопределено;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		// 2. Обработка по UUID (id)
		Идентификатор = "";
		Если Значение.Свойство("id", Идентификатор) И ЗначениеЗаполнено(Идентификатор) Тогда
			УИД = Новый УникальныйИдентификатор(Идентификатор);
			Если КлассОбъекта = "Справочник" Тогда Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "Документ" Тогда Возврат Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "ПланВидовХарактеристик" Или КлассОбъекта = "ПВХ" Тогда Возврат ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "ПланСчетов" Тогда Возврат ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(УИД);
			КонецЕсли;
		КонецЕсли;
		
		// 3. Обработка по Полям Поиска (динамический запрос)
		СтруктураПоиска = Неопределено;
		Если Значение.Свойство("ПоляПоиска", СтруктураПоиска) И ТипЗнч(СтруктураПоиска) = Тип("Структура") И СтруктураПоиска.Количество() > 0 Тогда
			
			ЗапросПоиска = Новый Запрос;
			ТекстУсловий = "";
			
			Для каждого КлючИЗначение Из СтруктураПоиска Цикл
				ИмяПоля = КлючИЗначение.Ключ;
				Если ЗначениеЗаполнено(ТекстУсловий) Тогда
					ТекстУсловий = ТекстУсловий + " И ";
				КонецЕсли;
				ТекстУсловий = ТекстУсловий + ИмяПоля + " = &" + ИмяПоля;
				ЗапросПоиска.УстановитьПараметр(ИмяПоля, КлючИЗначение.Значение);
			КонецЦикла;
			
			ЗапросПоиска.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ " + Значение.Тип + " ГДЕ " + ТекстУсловий;
			Выборка = ЗапросПоиска.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
			
			// Если объект не найден, возвращаем пустую ссылку нужного типа
			Если КлассОбъекта = "Справочник" Тогда Возврат Справочники[ИмяОбъекта].ПустаяСсылка();
			ИначеЕсли КлассОбъекта = "Документ" Тогда Возврат Документы[ИмяОбъекта].ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// 4. Обработка дат стандарта ISO
	Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) >= 19 
		И Сред(Значение, 5, 1) = "-" И Сред(Значение, 11, 1) = "T" Тогда
		Попытка
			Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "-", ""), "T", ""), ":", ""));
		Исключение
			// Оставляем исходную строку, если формат некорректен
		КонецПопытки;
	КонецЕсли;

	// Примитивные типы (числа, строки, булево) возвращаем как есть
	Возврат Значение;
	
КонецФункции

Функция exchange_ЗаписьДанных(Запрос) Экспорт
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);  
		
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			ВызватьИсключение "Тело запроса пустое. Ожидаются данные в формате JSON.";
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);  
		ДанныеОбъекта = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") Или Не ДанныеОбъекта.Свойство("ТипОбъекта") Тогда
			ВызватьИсключение "Некорректный формат. Ожидается ключ 'ТипОбъекта'.";
		КонецЕсли;
		
		ЧастиТипа = СтрРазделить(ДанныеОбъекта.ТипОбъекта, ".");
		Если ЧастиТипа.Количество() < 2 Тогда
			ВызватьИсключение "Неверный формат типа объекта. Ожидается Вид.Имя (например, Справочник.Номенклатура)";
		КонецЕсли;
		
		КлассОбъекта = ЧастиТипа[0];
		ИмяОбъекта = ЧастиТипа[1];
		
		// --- ЛОГИКА ПОИСКА СУЩЕСТВУЮЩЕГО ОБЪЕКТА ---
		СсылкаНаОбъект = Неопределено;
		ЕстьID = ДанныеОбъекта.Свойство("id") И ЗначениеЗаполнено(ДанныеОбъекта.id);
		
		// 1. Пробуем найти по UUID
		Если ЕстьID Тогда
			УИД = Новый УникальныйИдентификатор(ДанныеОбъекта.id);
			Если КлассОбъекта = "Справочник" Тогда
				СсылкаНаОбъект = Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "Документ" Тогда
				СсылкаНаОбъект = Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "ПланВидовХарактеристик" Или КлассОбъекта = "ПВХ" Тогда
				СсылкаНаОбъект = ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(УИД);
			ИначеЕсли КлассОбъекта = "ПланСчетов" Тогда
				СсылкаНаОбъект = ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(УИД);
			КонецЕсли;
		КонецЕсли;
		
		// Получение ссылки по UUID не подтверждает наличие объекта; проверяем ВерсияДанных.
		ОбъектСуществует = Ложь;
		Если СсылкаНаОбъект <> Неопределено И Не СсылкаНаОбъект.Пустая() Тогда
			Если ЗначениеЗаполнено(СсылкаНаОбъект.ВерсияДанных) Тогда
				ОбъектСуществует = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// 2. Если по UUID объект не найден, ищем по полям поиска (ИНН, Код и т.д.)
		СтруктураПоиска = Неопределено;
		Если Не ОбъектСуществует И ДанныеОбъекта.Свойство("ПоляПоиска", СтруктураПоиска) 
			И ТипЗнч(СтруктураПоиска) = Тип("Структура") И СтруктураПоиска.Количество() > 0 Тогда
			
			ЗапросПоиска = Новый Запрос;
			ТекстУсловий = "";
			Для каждого КлючИЗначение Из СтруктураПоиска Цикл
				ИмяПоля = КлючИЗначение.Ключ;
				Если ЗначениеЗаполнено(ТекстУсловий) Тогда
					ТекстУсловий = ТекстУсловий + " И ";
				КонецЕсли;
				ТекстУсловий = ТекстУсловий + ИмяПоля + " = &" + ИмяПоля;
				ЗапросПоиска.УстановитьПараметр(ИмяПоля, КлючИЗначение.Значение);
			КонецЦикла;
			
			// Значения поиска передаются параметрами; имена таблицы и полей берутся из запроса клиента.
			ЗапросПоиска.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ " + ДанныеОбъекта.ТипОбъекта + " ГДЕ " + ТекстУсловий;
			Выборка = ЗапросПоиска.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СсылкаНаОбъект = Выборка.Ссылка;
				ОбъектСуществует = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// --- ПОЛУЧЕНИЕ ИЛИ СОЗДАНИЕ ОБЪЕКТА ---
		ТекущийОбъект = Неопределено;
		Если ОбъектСуществует Тогда
			ТекущийОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		Иначе
			// Создаем новый объект, если старый не обнаружен
			Если КлассОбъекта = "Справочник" Тогда
				ТекущийОбъект = Справочники[ИмяОбъекта].СоздатьЭлемент();
			ИначеЕсли КлассОбъекта = "Документ" Тогда
				ТекущийОбъект = Документы[ИмяОбъекта].СоздатьДокумент();
				ТекущийОбъект.Дата = ТекущаяДата(); 
			ИначеЕсли КлассОбъекта = "ПланВидовХарактеристик" Или КлассОбъекта = "ПВХ" Тогда
				ТекущийОбъект = ПланыВидовХарактеристик[ИмяОбъекта].СоздатьЭлемент();
			ИначеЕсли КлассОбъекта = "ПланСчетов" Тогда
				ТекущийОбъект = ПланыСчетов[ИмяОбъекта].СоздатьСчет();
			Иначе
				ВызватьИсключение "Создание типа " + КлассОбъекта + " не поддерживается.";
			КонецЕсли;
			
			// Если объект новый, но из внешней базы пришел конкретный id, сохраняем его
			Если ЕстьID И ТекущийОбъект <> Неопределено Тогда
				ТекущийОбъект.УстановитьСсылкуНового(СсылкаНаОбъект);
			КонецЕсли;
		КонецЕсли;
		
		// 3. Заполняем реквизиты шапки
		СтруктураРеквизитов = Неопределено;
		Если ДанныеОбъекта.Свойство("Реквизиты", СтруктураРеквизитов) Тогда
			Для каждого КлючИЗначение Из СтруктураРеквизитов Цикл
				ТекущийОбъект[КлючИЗначение.Ключ] = ПодготовитьЗначениеКЗаписи(КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		
		// 4. Заполняем табличные части
		СтруктураТЧ = Неопределено;
		Если ДанныеОбъекта.Свойство("ТабличныеЧасти", СтруктураТЧ) Тогда
			Для каждого КлючИЗначение Из СтруктураТЧ Цикл
				ИмяТЧ = КлючИЗначение.Ключ;
				МассивСтрок = КлючИЗначение.Значение;
				
				// Очищаем ТЧ перед заполнением, чтобы строки не накапливались при повторном обновлении
				ТекущийОбъект[ИмяТЧ].Очистить();
				
				Для каждого СтрокаТЧ Из МассивСтрок Цикл
					НоваяСтрока = ТекущийОбъект[ИмяТЧ].Добавить();
					Для каждого Колонка Из СтрокаТЧ Цикл
						НоваяСтрока[Колонка.Ключ] = ПодготовитьЗначениеКЗаписи(Колонка.Значение);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		// 5. Записываем объект
		ТекущийОбъект.Записать();
		
		// Формируем ответ с указанием выполненного действия
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("response", "ok");
		ДанныеОтвета.Вставить("id", Строка(ТекущийОбъект.Ссылка.УникальныйИдентификатор()));
		ДанныеОтвета.Вставить("action", ?(ОбъектСуществует, "updated", "created"));
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(СериализоватьВJSON(ДанныеОтвета), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		ОшибкаОтвета = Новый Структура("response, error", "error", ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки(СериализоватьВJSON(ОшибкаОтвета), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
	КонецПопытки;
КонецФункции

