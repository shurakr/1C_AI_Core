
// Создает и возвращает COM-соединение с внешней базой УПП.
// СсылкаНаБазу — элемент справочника настроек внешних информационных баз.
Функция ПодключитьсяКВнешнейБазе(СсылкаНаБазу) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаБазу) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 1. Достаем пароль из БСП
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СсылкаНаБазу);
	Если Пароль = Неопределено Тогда
		Пароль = ""; // Если хранилище не вернуло пароль, используется пустая строка.
	КонецЕсли;
	
	V83COM = Новый COMОбъект("V83.COMConnector");
	
	// 2. Формируем строку в зависимости от типа базы
	Если ЗначениеЗаполнено(СсылкаНаБазу.ИмяСервера) Тогда
		СтрокаСоединения = СтрШаблон("Srvr=""%1"";Ref=""%2"";Usr=""%3"";Pwd=""%4"";", 
			СсылкаНаБазу.ИмяСервера, 
			СсылкаНаБазу.ИмяБазыНаСервере, 
			СсылкаНаБазу.Пользователь, 
			Пароль);
	Иначе
		СтрокаСоединения = СтрШаблон("File=""%1"";Usr=""%2"";Pwd=""%3"";", 
			СсылкаНаБазу.ПутьКФайловойБазе, 
			СсылкаНаБазу.Пользователь, 
			Пароль);
	КонецЕсли;
	
	Попытка
		Возврат V83COM.Connect(СтрокаСоединения);
	Исключение
		ЗаписьЖурналаРегистрации("Bank_AI.Интеграция", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка подклбючения к внешней базе: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Читает объект из УПП и возвращает Структуру с примитивными типами, 
// чтобы результат не зависел от COM-ссылок внешнего соединения.
Функция ПрочитатьОбъектУПП(Соединение, ВидМетаданных, ИмяМетаданных, СтрокаУИД) Экспорт
	
	Попытка
		
		// ВидМетаданных: "Справочники", "Документы" и т.д.
		УИД_COM = Соединение.NewObject("УникальныйИдентификатор", СтрокаУИД);
		СсылкаCOM = Соединение[ВидМетаданных][ИмяМетаданных].ПолучитьСсылку(УИД_COM);
		
		Если СсылкаCOM.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Подготавливаем данные для вызывающей базы.
		Результат = Новый Структура;
		Результат.Вставить("Ref_UUID", СтрокаУИД);
		
		МетаданныеCOM = СсылкаCOM.Метаданные();
		Для Каждого Реквизит Из МетаданныеCOM.Реквизиты Цикл
			ЗначениеРеквизита = СсылкаCOM[Реквизит.Имя];
			
			// ВАЖНО: Если реквизит - это ссылка на другой справочник УПП, 
			// мы сохраняем его строковое представление и УИД, а не COMОбъект.
			Если Соединение.XMLТипЗнч(ЗначениеРеквизита) <> Неопределено И Соединение.Метаданные.Справочники.Содержит(ЗначениеРеквизита.Метаданные()) Тогда
				Результат.Вставить(Реквизит.Имя + "_Имя", Соединение.String(ЗначениеРеквизита));
				Результат.Вставить(Реквизит.Имя + "_УИД", Соединение.String(ЗначениеРеквизита.УникальныйИдентификатор()));
			Иначе
				// Остальные значения сохраняются без дополнительного преобразования.
				Результат.Вставить(Реквизит.Имя, ЗначениеРеквизита);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат; 
		
	Исключение
		ЗаписьЖурналаРегистрации("Bank_AI.Интеграция", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка чтения из внешней базы: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	
КонецФункции


// Изменяет реквизиты объекта в УПП по его УИД
Функция ОбновитьРеквизитыОбъектаУПП(Соединение, ВидМетаданных, ИмяМетаданных, СтрокаУИД, СтруктураНовыхЗначений) Экспорт
	
	УИД_COM = Соединение.NewObject("УникальныйИдентификатор", СтрокаУИД);
	СсылкаCOM = Соединение[ВидМетаданных][ИмяМетаданных].ПолучитьСсылку(УИД_COM);
	
	Если СсылкаCOM.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектCOM = СсылкаCOM.ПолучитьОбъект();
	
	Для Каждого КлючЗначение Из СтруктураНовыхЗначений Цикл
		// Ссылочное значение должно принадлежать контексту внешней базы, а не вызывающей.
		ОбъектCOM[КлючЗначение.Ключ] = КлючЗначение.Значение; 
	КонецЦикла;
	
	Попытка
		ОбъектCOM.Записать();
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Bank_AI.Интеграция", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка записи во внешнюю базу: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Вызывает метод общего модуля, доступного во внешнем соединении.
Функция ВызватьМетодУПП(Соединение, ИмяОбщегоМодуля, ИмяМетода, МассивПараметров = Неопределено) Экспорт
	
	Попытка
		Если МассивПараметров = Неопределено Или МассивПараметров.Количество() = 0 Тогда
			
			ТекстВызова = "Соединение." + ИмяОбщегоМодуля + "." + ИмяМетода + "()";
			Возврат Вычислить(ТекстВызова);
			
		ИначеЕсли МассивПараметров.Количество() = 1 Тогда
			
			// Локальная переменная передаётся в выражение вызова как параметр.
			Пар0 = МассивПараметров[0]; 
			ТекстВызова = "Соединение." + ИмяОбщегоМодуля + "." + ИмяМетода + "(Пар0)";
			Возврат Вычислить(ТекстВызова);
			
		ИначеЕсли МассивПараметров.Количество() = 2 Тогда
			
			Пар0 = МассивПараметров[0];
			Пар1 = МассивПараметров[1];
			ТекстВызова = "Соединение." + ИмяОбщегоМодуля + "." + ИмяМетода + "(Пар0, Пар1)";
			Возврат Вычислить(ТекстВызова);
			
		Иначе			
			// При трёх и более входных значениях целевой метод получает один массив параметров.
			
			// Сериализуем массив параметров в вызывающей базе.
			СтрокаJSON = Расш_Банк_Сериализация.СериализоватьВJSONСтроку(МассивПараметров);
			
			// ЧтениеJSON создаётся в контексте внешнего соединения.
			// Десериализация создаст массив в той же базе, где выполняется целевой метод.
			ЧтениеJSON_УПП = Соединение.NewObject("ЧтениеJSON");
			ЧтениеJSON_УПП.УстановитьСтроку(СтрокаJSON);
			
			// 3. Вызываем десериализацию на стороне УПП
			// Теперь МассивПараметров_УПП - это COM-ссылка на реальный массив внутри УПП
			МассивПараметров_УПП = Соединение.ПрочитатьJSON(ЧтениеJSON_УПП);
			
			// 4. Передаем этот массив в целевой метод
			// ПРИМЕЧАНИЕ: Метод в УПП должен принимать один параметр (Массив)
			ТекстВызова = "Соединение." + ИмяОбщегоМодуля + "." + ИмяМетода + "(МассивПараметров_УПП)";
			Возврат Вычислить(ТекстВызова);			
		КонецЕсли;		
	Исключение
		ЗаписьЖурналаРегистрации("Bank_AI.Интеграция", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка вызова метода во внешней базе: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции      


// Возвращает структуру с описанием полей объекта УПП
Функция ПолучитьОписаниеОбъектаУПП(Соединение, ВидМетаданных, ИмяМетаданных) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", ИмяМетаданных);
	Результат.Вставить("Реквизиты", Новый Массив);
	Результат.Вставить("ТабличныеЧасти", Новый Структура);
	
	Попытка
		// Обращаемся к дереву метаданных УПП
		МетаОбъект = Соединение.Метаданные[ВидМетаданных][ИмяМетаданных];
		
		// Коллекция Реквизиты содержит пользовательские реквизиты, без стандартных.
		Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
			Результат.Реквизиты.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		// 2. Собираем структуру табличных частей
		Для Каждого ТЧ Из МетаОбъект.ТабличныеЧасти Цикл
			МассивПолейТЧ = Новый Массив;
			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				МассивПолейТЧ.Добавить(РеквизитТЧ.Имя);
			КонецЦикла;
			Результат.ТабличныеЧасти.Вставить(ТЧ.Имя, МассивПолейТЧ);
		КонецЦикла;
		
	Исключение
		ЗаписьЖурналаРегистрации("Bank_AI.УПП", УровеньЖурналаРегистрации.Ошибка,,, 
			СтрШаблон("Ошибка чтения метаданных %1.%2: %3", ВидМетаданных, ИмяМетаданных, ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции    


// Собирает имена реквизитов и табличных частей для перечисленных ниже коллекций метаданных.
Функция ВыгрузитьПолнуюСхемуМетаданных(Соединение) Экспорт
	
	Схема = Новый Структура;
	
	// Коллекции метаданных, включаемые в выгрузку схемы.
	СтрокаКоллекций = "Справочники,Документы,Перечисления,ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,БизнесПроцессы,Задачи";
	Коллекции = СтрРазделить(СтрокаКоллекций, ",");
	
	Для Каждого ТипОбъекта Из Коллекции Цикл
		
		Схема.Вставить(ТипОбъекта, Новый Структура);
		
		// Для регистров и перечислений состав описания отличается.
		ЭтоРегистр      = (СтрНайти(ТипОбъекта, "Регистр") > 0);
		ЭтоПеречисление = (ТипОбъекта = "Перечисления");
		
		Для Каждого МетаОбъект Из Соединение.Метаданные[ТипОбъекта] Цикл
			
			ИмяОбъекта = Соединение.String(МетаОбъект.Имя);
			
			Описание = Новый Структура("Синоним, Реквизиты, ТабличныеЧасти");
			Описание.Синоним = Соединение.String(МетаОбъект.Синоним);
			Описание.Реквизиты = Новый Массив;
			Описание.ТабличныеЧасти = Новый Структура;
			
			// === 1. ПЕРЕЧИСЛЕНИЯ ===
			Если ЭтоПеречисление Тогда
				Для Каждого Зн Из МетаОбъект.ЗначенияПеречисления Цикл
					Описание.Реквизиты.Добавить(Соединение.String(Зн.Имя) + " (значение)");
				КонецЦикла;
			Иначе
				// === 2. ОСТАЛЬНЫЕ ОБЪЕКТЫ ===
				
				// А. Стандартные реквизиты (Дата, Номер, Код, Наименование, Владелец и т.д.)
				Попытка 
					Для Каждого СтРекв Из МетаОбъект.СтандартныеРеквизиты Цикл
						Описание.Реквизиты.Добавить(Соединение.String(СтРекв.Имя));
					КонецЦикла;
				Исключение КонецПопытки;
				
				// Б. Обычные пользовательские реквизиты
				Для Каждого Рекв Из МетаОбъект.Реквизиты Цикл
					Описание.Реквизиты.Добавить(Соединение.String(Рекв.Имя));
				КонецЦикла;
				
				// Измерения и ресурсы регистров.
				Если ЭтоРегистр Тогда
					Для Каждого Изм Из МетаОбъект.Измерения Цикл
						Описание.Реквизиты.Добавить(Соединение.String(Изм.Имя) + " (изм)");
					КонецЦикла;
					Для Каждого Рес Из МетаОбъект.Ресурсы Цикл
						Описание.Реквизиты.Добавить(Соединение.String(Рес.Имя) + " (рес)");
					КонецЦикла;
				КонецЕсли;
				
				// Табличные части читаются только для объектов, не являющихся регистрами.
				Если Не ЭтоРегистр Тогда
					Попытка
						Для Каждого ТЧ Из МетаОбъект.ТабличныеЧасти Цикл
							МассивПолейТЧ = Новый Массив;
							Для Каждого РеквТЧ Из ТЧ.Реквизиты Цикл
								МассивПолейТЧ.Добавить(Соединение.String(РеквТЧ.Имя));
							КонецЦикла;
							Описание.ТабличныеЧасти.Вставить(Соединение.String(ТЧ.Имя), МассивПолейТЧ);
						КонецЦикла;
					Исключение КонецПопытки; // У некоторых видов метаданных коллекция ТабличныеЧасти недоступна.
				КонецЕсли;
				
			КонецЕсли;
			
			Схема[ТипОбъекта].Вставить(ИмяОбъекта, Описание);
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Схема;
	
КонецФункции